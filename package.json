{
  "name": "clinic",
  "version": "1.0.0",
  "description": "Clinic Management Application",
  "author": "Afghair",
  "main": "electron.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "38.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.afghair.clinic",
    "productName": "Clinic",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron.js",
      "index.html",
      "app-bundle.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
