{
  "name": "aestheticflow",
  "version": "1.0.0",
  "description": "AestheticFlow Cosmetic Clinic Management System",
  "main": "electron.js",
  "author": "AestheticFlow",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.aestheticflow.clinic",
    "productName": "AestheticFlow",
    "files": [
      "index.html",
      "app-bundle.js",
      "electron.js",
      "package.json"
    ],
    "win": {
      "target": "nsis"
      
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
